{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Algorithm": "HS256",
    "Issuer": "Aegis.Api",
    "Audience": "Aegis.Client",
    "KeyId": "aegis-primary-01",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "ClockSkewSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:5173"
    ]
  },
  "ReverseProxy": {
    "Enabled": false,
    "KnownProxies": []
  },
  "RateLimiting": {
    "WindowSeconds": 60,
    "LoginIpPermitLimit": 5,
    "OtherIpPermitLimit": 5,
    "LoginAccountPermitLimit": 5,
    "AccountPartitionCapacity": 10000
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
